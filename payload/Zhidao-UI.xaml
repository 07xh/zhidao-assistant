<TextBlock x:Name="QrLoginStateText" Text="尚未开始新一轮扫码" Foreground="{DynamicResource UiForeground_62788E}" FontSize="12" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel></Border>
